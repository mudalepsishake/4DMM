diff --git a/drivers/glrend/gstored.c b/drivers/glrend/gstored.c
index 4c3fb2d..c35aedf 100644
--- a/drivers/glrend/gstored.c
+++ b/drivers/glrend/gstored.c
@@ -125,7 +125,14 @@ static GLuint build_ibo(const GladGLContext *gl, const struct v11model *model, s
         groups[i].line_offset = (void *)(br_uintptr_t)index_offset;
 
         if(gp->edges != NULL && gp->nedges > 1) {
-            br_uint_8 *seen = BrScratchAllocate(gp->nedges * sizeof(*seen));
+            /*
+             * build_ibo() already owns BRender's single global scratchpad in
